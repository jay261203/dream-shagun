# web/.env.local  (for `npm run dev`, web/.env.development.local overrides it with the local Supabase)
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (or the older "anon" key). Safe for the browser. Never the secret service key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Where the web server reaches the API from. Used server side only, so the browser never calls the API directly.
API_URL_INTERNAL=http://localhost:8000
# The public address of the site, used in share tags and sign-in redirects. Leave empty locally.
NEXT_PUBLIC_SITE_URL=

# api/.env  (and api/.env.local on top of it for development; it must point at the SAME Supabase as the web app,
# otherwise the API rejects every login token with 401)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects that still sign login tokens with a shared secret (local Supabase before 2026, older hosted projects).
# New projects use a key pair, which the API reads from SUPABASE_URL.
SUPABASE_JWT_SECRET=

# supabase/.env  (never committed; see docs/google-login.md)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
